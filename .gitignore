# ---------------------------------------------------------------
# .gitignore for NumberRecognitionSystem
#
# A leading "/" means "only at the repository root", so these rules do not
# accidentally hide a folder with the same name inside src/ (for example a
# teammate's src/segmentation/data/ folder).
# ---------------------------------------------------------------

# Virtual environments: every person builds their own with requirements.txt
/venv/
/.venv/

# Downloaded MNIST dataset (the scripts re-download it automatically)
/data/

# Python cache files (these can appear in any folder)
__pycache__/
*.py[cod]

# Jupyter notebook autosaves
.ipynb_checkpoints/

# Editor and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Local settings and secrets
.env

# NOT ignored on purpose:
#   results/       plots used as evidence in the worklogs and reports
#   saved_models/  trained weights (.pth), 
